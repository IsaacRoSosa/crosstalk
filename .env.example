# Copy this file to .env and fill in the values. Never commit .env.

# Spotify (server only). The app owner needs an active Spotify Premium subscription.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius (server only, optional): only used to link each song to its Genius lyrics page.
# Lyrics come from LRCLIB (https://lrclib.net), which needs no key.
GENIUS_ACCESS_TOKEN=

# YouTube Data API (server only), used to find a playable video for each track
YOUTUBE_API_KEY=

# AI: each user connects their own OpenRouter account (free models only), so the server needs no AI key.
# Encrypts users' OpenRouter keys before they are stored. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it disconnects everyone's AI.
AI_KEY_ENCRYPTION_SECRET=
# Public URL of the app (sent to OpenRouter for attribution)
APP_URL=http://localhost:3000

# Supabase. Use the new keys (Project Settings > API Keys); the legacy anon/service_role keys are being retired.
# Public by design: exposed to the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses Row Level Security, never expose it
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (bot check before anonymous sign-in). Create a Managed widget for your domains;
# the site key is public. Put the secret key in Supabase > Authentication > Bot and Abuse Protection
# (provider: Turnstile), not here. Add localhost to the widget's hostnames and use the same site key
# locally: once the captcha is on in Supabase, anonymous sign-in fails without a token.
VITE_TURNSTILE_SITE_KEY=
